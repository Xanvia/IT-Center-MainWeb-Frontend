# Frontend Environment Variables

# Public variables (available in browser)
NEXT_PUBLIC_BACKEND_URL=http://localhost:5100
NEXT_PUBLIC_SITE_KEY=your_site_key_here

# Server-only variables (NextAuth configuration)
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:5000

# Internal backend URL for server-side requests
# In Docker: use service name (e.g., http://backend:5100)
# In development: use localhost (e.g., http://localhost:5100)
INTERNAL_BACKEND_URL=http://localhost:5100

# Production example for Docker Compose:
# INTERNAL_BACKEND_URL=http://backend:5100
